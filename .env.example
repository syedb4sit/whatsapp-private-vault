# WhatsApp Cloud API
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=choose_any_random_string_here

# OpenAI (for intent parsing + embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Vault encryption key (32 chars for AES-256)
VAULT_ENCRYPTION_KEY=change_this_to_32_random_chars!!

# Server
PORT=3000

# Your personal WhatsApp number (E.164 format, e.g. 923001234567)
# Only messages from this number will be accepted
OWNER_PHONE=923001234567
